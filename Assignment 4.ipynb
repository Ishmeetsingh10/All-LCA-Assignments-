    "#PYTHON PROGRAM TO CREATE AN ARRAY AND PERFORM ADDITION OF 2 MATRICES(using list and numpy array)\n",
    "import numpy as np\n",
    "\n",
    "A = np.array([[1, 2],[3, 4]])\n",
    "\n",
    "B = np.array([[5, 6],[7, 8]])\n",
    "\n",
    "result = A + B\n",
    "print(result)"
